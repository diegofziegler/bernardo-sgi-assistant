# Puerto donde correrá Bernardo
PORT=8001

# URL del endpoint de chat de tu servicio RAG (entrega_7)
RAG_API_URL=http://localhost:8000/api/v1/chat

# Conexión a Redis para persistencia de sesión de Bernardo
REDIS_URL=redis://localhost:6379/1
SESSION_TTL_SECONDS=86400

# Orígenes permitidos para CORS (URL donde corre tu app SGI en BackboneJS)
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080", "https://tu-dominio-sgi.com"]

# Seguridad para publicación de alertas proactivas desde monitoreo/CI/CD
ADMIN_API_KEY=cambia_este_token_secreto_sgi